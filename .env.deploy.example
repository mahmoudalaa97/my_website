# Copy to .env.deploy at repo root (gitignored) and fill in your values.
# Then run: ./scripts/setup-github-secrets.sh

HOSTINGER_HOST=82.112.243.32
HOSTINGER_USER=u661321560
HOSTINGER_PORT=65002

# Remote paths (relative to home ~/) — must match hPanel subdomain folders
HOSTINGER_WEB_DIR=domains/mahmoudalaa.com/public_html
HOSTINGER_ADMIN_DIR=domains/admin.mahmoudalaa.com/public_html
HOSTINGER_API_DIR=domains/api.mahmoudalaa.com/public_html

# Dedicated deploy key for GitHub Actions (generate separately — see docs/HOSTINGER.md)
HOSTINGER_SSH_KEY_PATH=~/.ssh/id_ed25519_hostinger

# Build-time URL baked into Next.js (also set as GitHub repo variable)
NEXT_PUBLIC_API_URL=https://api.mahmoudalaa.com/api

# Optional health-check URLs (stored as GitHub secrets)
API_HEALTH_URL=https://api.mahmoudalaa.com/api/health
WEB_HEALTH_URL=https://mahmoudalaa.com
ADMIN_HEALTH_URL=https://admin.mahmoudalaa.com
