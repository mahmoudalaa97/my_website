# Environment Variables for Development
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_website

# Database Connection (used by migrations/seeds)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=my_website

# API Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/my_website
JWT_SECRET=your-dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin User (created during seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Super Admin

# Email Configuration (Optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@mahmoudalaa.com
