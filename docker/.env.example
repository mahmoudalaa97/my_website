# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_NAME=website_db
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# API Configuration
API_PORT=4000
API_URL=https://api.mahmoudalaa.com

# Web App Configuration
WEB_PORT=3000
WEB_URL=https://www.mahmoudalaa.com

# Admin Dashboard Configuration
ADMIN_PORT=3001
ADMIN_URL=https://dashboard.mahmoudalaa.com

# Next.js Public API URL
NEXT_PUBLIC_API_URL=https://api.mahmoudalaa.com

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_min_32_chars
SESSION_SECRET=your_session_secret_here_min_32_chars

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@mahmoudalaa.com

# Frontend URLs
FRONTEND_URL=https://dashboard.mahmoudalaa.com
