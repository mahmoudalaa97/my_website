# Hostinger production env template — copy to .env on the server and fill in.
# Generate APP_KEY once with: php artisan key:generate --show

APP_NAME=MyWebsite
APP_ENV=production
APP_KEY=                              # base64:... (generate on the server)
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Hostinger MySQL — get from hPanel → Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                          # u123_my_website
DB_USERNAME=                          # u123_dbuser
DB_PASSWORD=

# --- Sessions / cookies (cross-subdomain SPA auth) ---
# Leading dot makes the cookie valid for yourdomain.com AND admin.yourdomain.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Sanctum (must list every frontend host that calls the API) ---
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,admin.yourdomain.com

# --- CORS allow-list (read by config/cors.php) ---
WEB_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Cache / queues — keep on database to avoid Redis on shared hosting ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Default super-admin (used by db:seed on first run) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=                       # set a strong password
ADMIN_NAME=Super Admin

# --- Mail (Hostinger SMTP from hPanel → Emails) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
