# Hostinger production — copy to .env on the server and fill in DB_* and ADMIN_PASSWORD.

APP_NAME=MyWebsite
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mahmoudalaa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mahmoudalaa.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=mahmoudalaa.com,admin.mahmoudalaa.com

WEB_URL=https://mahmoudalaa.com
ADMIN_URL=https://admin.mahmoudalaa.com
FRONTEND_URL=https://mahmoudalaa.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

ADMIN_EMAIL=admin@mahmoudalaa.com
ADMIN_PASSWORD=
ADMIN_NAME="Super Admin"

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@mahmoudalaa.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
