{
  "name": "my-website-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "dev:apps": "turbo dev --filter=@repo/web --filter=@repo/admin --concurrency 10",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "dev:api": "cd apps/api-php && php artisan serve --port=8000",
    "db:migrate": "cd apps/api-php && php artisan migrate",
    "db:seed": "cd apps/api-php && php artisan db:seed"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@9.0.0"
}
