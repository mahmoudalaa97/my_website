{
  "name": "my-website-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "dev:api": "turbo dev --filter=@repo/api",
    "db:migrate": "turbo db:migrate --filter=@repo/api",
    "db:seed": "turbo db:seed --filter=@repo/api"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.0.0"
}
