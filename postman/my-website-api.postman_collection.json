{
  "info": {
    "name": "my_website API",
    "description": "End-to-end test collection for the Laravel API powering the web and admin frontends. Run top-to-bottom; each folder builds on the previous one (login captures the bearer token; CRUD folders capture and clean up their own resources).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api" },
    { "key": "email", "value": "admin@admin.com" },
    { "key": "password", "value": "Admin123!" },
    { "key": "token", "value": "" },
    { "key": "svcId", "value": "" },
    { "key": "pkgId", "value": "" },
    { "key": "prjId", "value": "" },
    { "key": "msgId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Suppress bearer auth on requests that should be unauthenticated (set 'noAuth' header in those requests).",
          "if (pm.request.headers.get('X-Skip-Auth')) {",
          "  pm.request.auth = { type: 'noauth' };",
          "  pm.request.headers.remove('X-Skip-Auth');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.expect(pm.response.code).to.eql(200));",
              "const j = pm.response.json();",
              "pm.test('status:ok', () => pm.expect(j.status).to.eql('ok'));"
            ]}
          }]
        },
        {
          "name": "GET /health/live",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] }
