# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=website_db
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Application Ports (internal)
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Domain URLs
API_URL=https://api.mahmoudalaa.com
WEB_URL=https://mahmoudalaa.com
ADMIN_URL=https://dashboard.mahmoudalaa.com

# Next.js Public API URL (used by frontend)
NEXT_PUBLIC_API_URL=https://api.mahmoudalaa.com

# Security
JWT_SECRET=your_jwt_secret_here_change_this
SESSION_SECRET=your_session_secret_here_change_this

# Email Configuration (SMTP)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@mahmoudalaa.com
